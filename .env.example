# .env.example - a TEMPLATE showing which settings exist. This one IS committed.
# Setup:  copy .env.example .env   then fill in real values in .env

DEBUG=true

# mysql+aiomysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+aiomysql://root:@localhost:3306/fastapi_demo?charset=utf8mb4

# Generate your own:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
RESET_TOKEN_EXPIRE_MINUTES=15

MEDIA_DIR=media
MAX_UPLOAD_SIZE_MB=2

# JSON list of browser origins allowed to call the API (your frontend's URL)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

EMAIL_OUTBOX_FILE=logs/emails.log
